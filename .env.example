# ============================================
# FIRECOMPASS — Variables de entorno
# Copia este archivo como .env.local y rellena
# ============================================

# Claude API — console.anthropic.com
# Modelo principal: claude-sonnet-4-6
# Modelo rápido: claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-...

# Brave Search — brave.com/search/api (2000 búsquedas gratis/mes)
# Opcional: solo si usas búsqueda web en tiempo real
BRAVE_SEARCH_API_KEY=

# GitHub Token — github.com/settings/tokens
# Opcional: solo para MCP de GitHub
GITHUB_TOKEN=

# NASA APIs — NO necesitan API key
# PSI: https://psi.nasa.gov/geode-py/ws
# NTRS: https://ntrs.nasa.gov/api/citations/search
# Ambas son públicas y gratuitas
